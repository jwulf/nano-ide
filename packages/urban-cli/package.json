{
  "name": "@nanobpm/urban",
  "version": "0.1.0",
  "description": "The Urban CLI: scaffold, check, run, dev, and deploy Urban apps (nano.app.json) on Node or Deno. Thin command surface over @nanobpm/urban-runtime (ADR 0052).",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "nanobpm",
    "urban",
    "urban-cli",
    "cli",
    "nano-app",
    "rad"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwulf/nano-ide.git",
    "directory": "packages/urban-cli"
  },
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "urban": "./src/bin.mjs"
  },
  "main": "./src/cli.ts",
  "types": "./src/cli.ts",
  "exports": {
    ".": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nanobpm/urban-runtime": "^0.1.0",
    "@nanobpm/urban-toolkit": "^0.1.0",
    "create-urban-app": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
