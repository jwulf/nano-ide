{
  "name": "@nanobpm/urban",
  "version": "0.4.0",
  "description": "Urban: build and run code-first apps on Nano — runtime, derivation toolkit, and CLI in one. Author durable processes with @nanobpm/workflow (defineFlow), a typed datasource, forms, triggers and surfaces from a nano.app.json manifest, on Node or Deno.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "nanobpm",
    "urban",
    "cli",
    "runtime",
    "codegen",
    "derivation",
    "nano-app",
    "rad"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwulf/nano-ide.git",
    "directory": "packages/urban"
  },
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "urban": "./src/bin.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./toolkit": "./src/toolkit/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:deno": "deno test -A --no-check src/"
  },
  "dependencies": {
    "@nanobpm/nano-sdk": "^1.2.0",
    "@nanobpm/workflow": "^0.6.0",
    "bpmn-auto-layout": "^2.0.0-alpha.2",
    "create-urban-app": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
