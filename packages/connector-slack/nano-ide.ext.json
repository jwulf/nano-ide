{
  "id": "nano-ide-connector-slack",
  "kind": "trigger",
  "displayName": "Slack",
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 122.8 122.8'><path d='M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9zM32.3 77.6c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9z' fill='#e01e5a'/><path d='M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9zM45.2 32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9z' fill='#36c5f0'/><path d='M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97zM90.5 45.2c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9z' fill='#2eb67d'/><path d='M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97zM77.6 90.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9z' fill='#ecb22e'/></svg>",
  "triggerSources": [
    {
      "kind": "slack",
      "displayName": "Slack (events & slash commands)",
      "transport": "webhook",
      "driver": "driver.ts",
      "configFields": [
        {
          "key": "appToken",
          "label": "App-level token",
          "description": "Slack app-level token (xapp-...) with connections:write, used to open a Socket Mode connection. Point this at an env var; never inline the secret.",
          "env": "SLACK_APP_TOKEN"
        },
        {
          "key": "events",
          "label": "Event types",
          "description": "Comma-separated Slack event types to forward, e.g. app_mention, message.channels, or slash commands as slash:/deploy. Empty = every event the app is subscribed to.",
          "default": "app_mention"
        }
      ]
    }
  ],
  "components": ["components/send-message.json"],
  "workers": [
    {
      "type": "slack:send-message",
      "entry": "worker.ts",
      "displayName": "Send Slack Message",
      "maxParallelJobs": 10,
      "configFields": [
        {
          "key": "botToken",
          "label": "Bot token",
          "description": "Bot user OAuth token (xoxb-...) with chat:write, used to post messages. Point this at an env var; never inline the secret.",
          "env": "SLACK_BOT_TOKEN"
        }
      ]
    }
  ]
}
