{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["main.ts", "workflows/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
